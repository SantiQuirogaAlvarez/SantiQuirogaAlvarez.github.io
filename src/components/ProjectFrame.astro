---
interface Props {
  widthLabel?: string;
  heightLabel?: string;
  className?: string;
}

const {
  widthLabel = "1380PX",
  heightLabel = "548PX",
  className = "",
} = Astro.props;
---

<article class:list={["blueprint-card", "project-frame", className]}>
  <div class="blueprint-card__inner">
    <div class="blueprint-card__content">
      <slot />
    </div>
  </div>

  <div class="blueprint-card__dim blueprint-card__dim--right" aria-hidden="true">
    <span class="blueprint-card__cap blueprint-card__cap--top"></span>
    <span class="blueprint-card__segment blueprint-card__segment--top"></span>
    <span class="blueprint-card__label blueprint-card__label--right">{heightLabel}</span>
    <span class="blueprint-card__segment blueprint-card__segment--bottom"></span>
    <span class="blueprint-card__cap blueprint-card__cap--bottom"></span>
  </div>

  <div class="blueprint-card__dim blueprint-card__dim--bottom" aria-hidden="true">
    <span class="blueprint-card__cap blueprint-card__cap--left"></span>
    <span class="blueprint-card__segment blueprint-card__segment--left"></span>
    <span class="blueprint-card__label blueprint-card__label--bottom">{widthLabel}</span>
    <span class="blueprint-card__segment blueprint-card__segment--right"></span>
    <span class="blueprint-card__cap blueprint-card__cap--right"></span>
  </div>
</article>
